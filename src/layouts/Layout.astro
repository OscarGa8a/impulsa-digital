---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  alternate?: { lang: string; url: string };
}

const { lang, title, description, ogImage = '/og-image.png', canonical, alternate } = Astro.props;
const site = 'https://impulsadigital.co';
const canonicalUrl = canonical ? `${site}${canonical}` : `${site}${Astro.url.pathname}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- FOUC Prevention -->
		<script is:inline>
			(function() {
				try {
					const theme = localStorage.getItem('id_theme') || 'dark';
					const accent = localStorage.getItem('id_accent') || 'lime';
					const html = document.documentElement;
					if (theme === 'light') html.classList.add('light');
					html.setAttribute('data-accent', accent);
				} catch (e) {}
			})();
		</script>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{alternate && <link rel="alternate" hreflang={alternate.lang} href={`${site}${alternate.url}`} />}

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={`${site}${ogImage}`} />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site}${ogImage}`} />

		<slot name="head" />
		<ClientRouter />
	</head>
	<body>
		<slot />
		<script is:inline>
			(function() {
				function getStored(key, fallback) {
					try { return localStorage.getItem(key) || fallback; } catch (e) { return fallback; }
				}
				function setStored(key, value) {
					try { localStorage.setItem(key, value); } catch (e) {}
				}

				const html = document.documentElement;

				function updateThemeUI() {
					const isLight = html.classList.contains('light');
					const toggleBtn = document.getElementById('theme-toggle');
					if (toggleBtn) toggleBtn.setAttribute('aria-pressed', String(isLight));
				}

				function updateAccentUI(accent) {
					document.querySelectorAll('.accent-swatch[data-accent]').forEach(function(button) {
						button.classList.toggle('active', button.getAttribute('data-accent') === accent);
					});
				}

				function setAccent(accent) {
					html.setAttribute('data-accent', accent);
					setStored('id_accent', accent);
					updateAccentUI(accent);
				}

				function toggleTheme() {
					const isLight = html.classList.toggle('light');
					setStored('id_theme', isLight ? 'light' : 'dark');
					updateThemeUI();
				}

				function init() {
					const theme = getStored('id_theme', 'dark');
					const accent = getStored('id_accent', 'lime');
					if (theme === 'light') html.classList.add('light');
					else html.classList.remove('light');
					setAccent(accent);
					updateThemeUI();
				}

				// Bind events
				document.addEventListener('click', function(e) {
				const accentTarget = e.target.closest('.accent-swatch[data-accent]');
				if (accentTarget) setAccent(accentTarget.getAttribute('data-accent'));

				const target = e.target.closest('#theme-toggle');
					if (target) toggleTheme();
				});

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', init);
				} else {
					init();
				}
			})();
		</script>
	</body>
</html>
