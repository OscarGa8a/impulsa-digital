---
import { type LocaleContent } from '../data/content.ts';

interface Props {
  t: LocaleContent;
}

const { t } = Astro.props;
---

<section data-screen-label="faq">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><span class="dot"></span> {t.faq.eyebrow}</span>
      </div>
      <div>
        <h2>{t.faq.title} <i>{t.faq.titleI}</i>{t.faq.titleEnd}</h2>
      </div>
    </div>
    <div class="faq-list">
      {t.faq.items.map((it, i) => (
        <div class="faq-item" data-index={i}>
          <button class="faq-q" aria-expanded="false" type="button">
            <span>{it.q}</span>
            <span class="plus">+</span>
          </button>
          <div class="faq-a">{it.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const container = document.querySelector('[data-screen-label="faq"]');
    if (!container) return;
    const items = container.querySelectorAll('.faq-item');
    let openIndex = -1;

    items.forEach((item, index) => {
      const btn = item.querySelector('.faq-q');
      if (!btn) return;

      function toggle() {
        const isOpen = openIndex === index;
        if (isOpen) {
          item.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          openIndex = -1;
        } else {
          if (openIndex >= 0) {
            const prev = items[openIndex];
            if (prev) {
              prev.classList.remove('open');
              const prevBtn = prev.querySelector('.faq-q');
              if (prevBtn) prevBtn.setAttribute('aria-expanded', 'false');
            }
          }
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          openIndex = index;
        }
      }

      btn.addEventListener('click', toggle);
      btn.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  })();
</script>
