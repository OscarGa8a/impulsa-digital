---
import { type LocaleContent } from '../data/content.ts';

interface Props {
  t: LocaleContent;
}

const { t } = Astro.props;
---

<section id="services" data-screen-label="services">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><span class="dot"></span> {t.services.eyebrow}</span>
      </div>
      <div>
        <h2>{t.services.title} <i>{t.services.titleI}</i>{t.services.titleEnd}</h2>
        <p style="margin-top:18px">{t.services.desc}</p>
      </div>
    </div>
    <div class="services">
      {t.services.items.map((s, i) => (
        <article class={`service ${s.wide ? "wide" : ""}`} key={i}>
          <div style="display:flex; justify-content:space-between; align-items:flex-start">
            <div class="icon" aria-hidden="true">{s.icon}</div>
            <div class="num">{s.n}</div>
          </div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <div class="tags">
            {s.tags.map((tg, j) => <span class="tag" key={j}>{tg}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
