---
import { type LocaleContent } from '../data/content.ts';

interface Props {
  t: LocaleContent;
}

const { t } = Astro.props;
---

<section id="pricing" data-screen-label="pricing">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><span class="dot"></span> {t.pricing.eyebrow}</span>
      </div>
      <div>
        <h2>{t.pricing.title} <i>{t.pricing.titleI}</i>{t.pricing.titleEnd}</h2>
        <p style="margin-top:18px">{t.pricing.desc}</p>
      </div>
    </div>
    <div class="pricing">
      {t.pricing.plans.map((p, i) => (
        <div class={`plan ${p.featured ? "featured" : ""}`} key={i}>
          {p.featured && <div class="badge">★ Popular</div>}
          <div>
            <div class="name">{p.name}</div>
            <div class="desc">{p.desc}</div>
          </div>
          <div class="price">{p.price}<small>{p.unit}</small></div>
          <ul>
            {p.feat.map((f, j) => <li class="on" key={j}>{f}</li>)}
          </ul>
          <a href="#contact" class={`btn ${p.featured ? 'btn-primary' : 'btn-ghost'}`}>
            {t.pricing.cta}
            <svg class="arrow arrow-svg" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
